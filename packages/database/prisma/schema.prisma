// ═══════════════════════════════════════════════════════════
//  PediTrack — Pediatric Clinic Management Platform
//  Database Schema (PostgreSQL + Prisma)
// ═══════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PARENT // reserved for the upcoming mobile parents portal
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentType {
  CHECKUP
  FOLLOW_UP
  VACCINATION
  SICK_VISIT
  CONSULTATION
  EMERGENCY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ScreeningType {
  GENERAL
  AUTISM
  BEHAVIORAL
}

enum ScreeningOutcome {
  PASS
  MONITOR
  REFER
  INCOMPLETE
}

enum ReferralStatus {
  PENDING
  SCHEDULED
  COMPLETED
  DECLINED
  LOST
}

// Developmental surveillance — milestone checklists observed at every
// well-child visit, distinct from the four formal screening instruments above.
enum MilestoneDomain {
  SOCIAL_EMOTIONAL
  LANGUAGE_COMMUNICATION
  COGNITIVE
  MOVEMENT_PHYSICAL
}

enum MilestoneStatus {
  ACHIEVED
  EMERGING
  NOT_YET
  NOT_ASSESSED // the default — an unasked question must never read as a pass
  REGRESSED // loss of a skill already achieved; more urgent than NOT_YET
}

enum ObservationSource {
  CLINICIAN_OBSERVED
  CAREGIVER_REPORTED
}

enum AgeBasis {
  CHRONOLOGICAL
  CORRECTED
}

enum ConcernSource {
  CAREGIVER
  CLINICIAN
  TEACHER
  OTHER
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

// ─────────────────────────────────────────────────────────
//  USERS — clinic staff (and future parent accounts)
// ─────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(RECEPTIONIST)

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String?
  avatarUrl String? @map("avatar_url")

  // Doctor-specific
  licenseNumber String? @map("license_number")
  specialty     String?

  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  appointmentsAsDoctor   Appointment[]             @relation("DoctorAppointments")
  vaccinationsGiven      VaccinationRecord[]
  prescriptionsIssued    Prescription[]
  medicalNotes           MedicalNote[]
  vitalSignsRecorded     VitalSign[]
  screeningsAdministered ScreeningAdministration[]
  milestonesObserved     MilestoneObservation[]
  concernsRecorded       DevelopmentalConcern[]
  auditLogs              AuditLog[]

  @@index([email])
  @@index([role, isActive])
  @@map("users")
}

// ─────────────────────────────────────────────────────────
//  PATIENTS — the children
// ─────────────────────────────────────────────────────────

model Patient {
  id  String @id @default(cuid())
  mrn String @unique @map("mrn") // Medical Record Number, e.g. PT-2026-00001

  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  middleName  String?   @map("middle_name")
  dateOfBirth DateTime  @map("date_of_birth")
  gender      Gender
  bloodType   BloodType @default(UNKNOWN) @map("blood_type")

  // Birth details — important in pediatrics
  birthWeightKg  Float? @map("birth_weight_kg")
  birthHeightCm  Float? @map("birth_height_cm")
  gestationalAge Int?   @map("gestational_age_weeks")

  allergies         String[] @default([])
  chronicConditions String[] @default([]) @map("chronic_conditions")
  notes             String?

  photoUrl String? @map("photo_url")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  guardians                Guardian[]
  appointments             Appointment[]
  vaccinationRecords       VaccinationRecord[]
  prescriptions            Prescription[]
  medicalNotes             MedicalNote[]
  vitalSigns               VitalSign[]
  screeningAdministrations ScreeningAdministration[]
  milestoneObservations    MilestoneObservation[]
  developmentalConcerns    DevelopmentalConcern[]

  @@index([lastName, firstName])
  @@index([mrn])
  @@index([dateOfBirth])
  @@index([isActive, deletedAt])
  @@map("patients")
}

// ─────────────────────────────────────────────────────────
//  GUARDIANS — parents / caregivers
// ─────────────────────────────────────────────────────────

model Guardian {
  id        String @id @default(cuid())
  patientId String @map("patient_id")

  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  relationship String // Mother, Father, Grandparent, Legal Guardian...
  phone        String
  email        String?
  address      String?
  occupation   String?

  isPrimary          Boolean @default(false) @map("is_primary")
  isEmergencyContact Boolean @default(false) @map("is_emergency_contact")

  // Link to a future PARENT user account for the mobile app
  userId String? @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([phone])
  @@index([userId])
  @@map("guardians")
}

// ─────────────────────────────────────────────────────────
//  APPOINTMENTS — bookings & check-ups
// ─────────────────────────────────────────────────────────

model Appointment {
  id        String @id @default(cuid())
  patientId String @map("patient_id")
  doctorId  String @map("doctor_id")

  scheduledAt     DateTime          @map("scheduled_at")
  durationMinutes Int               @default(30) @map("duration_minutes")
  type            AppointmentType   @default(CHECKUP)
  status          AppointmentStatus @default(PENDING)

  chiefComplaint String? @map("chief_complaint")
  diagnosis      String?
  reasonForVisit String? @map("reason_for_visit")

  checkedInAt DateTime? @map("checked_in_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")

  reminderSentAt DateTime? @map("reminder_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient               Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor                User                      @relation("DoctorAppointments", fields: [doctorId], references: [id])
  vitalSign             VitalSign?
  prescriptions         Prescription[]
  medicalNotes          MedicalNote[]
  vaccinations          VaccinationRecord[]
  screenings            ScreeningAdministration[]
  milestoneObservations MilestoneObservation[]
  developmentalConcerns DevelopmentalConcern[]

  @@index([patientId, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([scheduledAt, status])
  @@index([status])
  @@map("appointments")
}

// ─────────────────────────────────────────────────────────
//  VITAL SIGNS — recorded per visit
// ─────────────────────────────────────────────────────────

model VitalSign {
  id            String @id @default(cuid())
  appointmentId String @unique @map("appointment_id")
  patientId     String @map("patient_id")
  recordedById  String @map("recorded_by_id")

  weightKg          Float? @map("weight_kg")
  heightCm          Float? @map("height_cm")
  headCircumference Float? @map("head_circumference_cm") // key pediatric metric
  temperatureC      Float? @map("temperature_c")
  heartRate         Int?   @map("heart_rate_bpm")
  respiratoryRate   Int?   @map("respiratory_rate")
  oxygenSaturation  Float? @map("oxygen_saturation")
  bloodPressureSys  Int?   @map("blood_pressure_systolic")
  bloodPressureDia  Int?   @map("blood_pressure_diastolic")

  bmi Float?

  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy  User        @relation(fields: [recordedById], references: [id])

  @@index([patientId, recordedAt])
  @@map("vital_signs")
}

// ─────────────────────────────────────────────────────────
//  VACCINES — reference catalogue
// ─────────────────────────────────────────────────────────

model Vaccine {
  id           String  @id @default(cuid())
  code         String  @unique // BCG, HEPB, DTAP, MMR, IPV...
  name         String
  description  String?
  manufacturer String?

  totalDoses           Int  @default(1) @map("total_doses")
  recommendedAgeMonths Int? @map("recommended_age_months")
  intervalDays         Int? @map("interval_days") // days until next dose

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  records VaccinationRecord[]

  @@index([code])
  @@map("vaccines")
}

// ─────────────────────────────────────────────────────────
//  VACCINATION RECORDS — administered doses
// ─────────────────────────────────────────────────────────

model VaccinationRecord {
  id               String  @id @default(cuid())
  patientId        String  @map("patient_id")
  vaccineId        String  @map("vaccine_id")
  administeredById String  @map("administered_by_id")
  appointmentId    String? @map("appointment_id")

  doseNumber     Int       @default(1) @map("dose_number")
  administeredAt DateTime  @map("administered_at")
  batchNumber    String?   @map("batch_number")
  expiryDate     DateTime? @map("expiry_date")
  site           String? // Left deltoid, Right thigh...
  route          String? // IM, SC, Oral

  nextDueDate DateTime? @map("next_due_date")

  adverseReaction String? @map("adverse_reaction")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  vaccine        Vaccine      @relation(fields: [vaccineId], references: [id])
  administeredBy User         @relation(fields: [administeredById], references: [id])
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])

  @@unique([patientId, vaccineId, doseNumber])
  @@index([patientId])
  @@index([nextDueDate])
  @@index([administeredAt])
  @@map("vaccination_records")
}

// ─────────────────────────────────────────────────────────
//  PRESCRIPTIONS — medicines prescribed
// ─────────────────────────────────────────────────────────

model Prescription {
  id            String  @id @default(cuid())
  patientId     String  @map("patient_id")
  doctorId      String  @map("doctor_id")
  appointmentId String? @map("appointment_id")

  status PrescriptionStatus @default(ACTIVE)
  notes  String?

  issuedAt   DateTime  @default(now()) @map("issued_at")
  validUntil DateTime? @map("valid_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User               @relation(fields: [doctorId], references: [id])
  appointment Appointment?       @relation(fields: [appointmentId], references: [id])
  items       PrescriptionItem[]

  @@index([patientId, issuedAt])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String @id @default(cuid())
  prescriptionId String @map("prescription_id")

  medicineName String  @map("medicine_name")
  genericName  String? @map("generic_name")
  dosage       String // "250mg", "5ml" — free-text label shown on the printed script
  form         String? // Syrup, Tablet, Drops
  frequency    String // "3x daily", "Every 8 hours"
  durationDays Int     @map("duration_days")
  quantity     String?
  instructions String? // "Take after meals"

  // Structured dose, in mg — optional, but required to run the weight-based
  // dose check against MedicineDoseReference. `dosage` above stays free text
  // because concentrations/volumes vary; these two fields are what makes the
  // dose computable.
  doseAmountMg Float? @map("dose_amount_mg")
  dosesPerDay  Int?   @map("doses_per_day")

  createdAt DateTime @default(now()) @map("created_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ─────────────────────────────────────────────────────────
//  MEDICINE DOSE REFERENCE — weight-based dosing safety
// ─────────────────────────────────────────────────────────

// Reference range per generic medicine. Pediatric doses are per-kilogram
// unlike adult dosing, so a prescription cannot be safety-checked without
// this table — and, like the milestone checklists, it must be transcribed
// from a real formulary and version-pinned rather than typed from memory.
model MedicineDoseReference {
  id          String @id @default(cuid())
  genericName String @unique @map("generic_name")

  mgPerKgDayMin   Float  @map("mg_per_kg_day_min")
  mgPerKgDayMax   Float  @map("mg_per_kg_day_max")
  maxSingleDoseMg Float? @map("max_single_dose_mg")
  maxDailyDoseMg  Float? @map("max_daily_dose_mg")

  source        String // e.g. "BNF for Children"
  sourceVersion String  @map("source_version") // e.g. "2024"
  notes         String?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("medicine_dose_references")
}

// ─────────────────────────────────────────────────────────
//  MEDICAL NOTES — clinical documentation
// ─────────────────────────────────────────────────────────

model MedicalNote {
  id            String  @id @default(cuid())
  patientId     String  @map("patient_id")
  appointmentId String? @map("appointment_id")
  authorId      String  @map("author_id")

  // SOAP note format
  subjective String?
  objective  String?
  assessment String?
  plan       String?

  content String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  author      User         @relation(fields: [authorId], references: [id])

  @@index([patientId, createdAt])
  @@map("medical_notes")
}

// ─────────────────────────────────────────────────────────
//  DEVELOPMENTAL SCREENING — structured, validated-instrument
//  screening events (AAP/Bright Futures periodicity: 9, 18,
//  24, 30 months). Distinct from free-text surveillance notes
//  in MedicalNote — this is queryable, due-date-tracked, and
//  loop-closing via ScreeningReferral.
// ─────────────────────────────────────────────────────────

// Screening instrument catalogue. Item text is deliberately NOT stored — a
// licensed instrument's items generally cannot be reproduced, and even for a
// free instrument this app stores scores/outcomes, not the questionnaire itself.
model ScreeningInstrument {
  id           String        @id @default(cuid())
  code         String        @unique // "MCHAT_R_F", "SWYC"
  name         String
  type         ScreeningType
  minAgeMonths Int           @map("min_age_months")
  maxAgeMonths Int           @map("max_age_months")
  cutoffNote   String?       @map("cutoff_note") // scoring-band guidance for the UI
  isActive     Boolean       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  administrations ScreeningAdministration[]

  @@index([type])
  @@map("screening_instruments")
}

// One screening event. Nullable appointmentId — like VaccinationRecord, a
// screening can be tied to a visit or entered from a returned paper form.
model ScreeningAdministration {
  id               String  @id @default(cuid())
  patientId        String  @map("patient_id")
  instrumentId     String  @map("instrument_id")
  appointmentId    String? @map("appointment_id")
  administeredById String  @map("administered_by_id")

  scheduledAgeMonths Int      @map("scheduled_age_months") // 9 | 18 | 24 | 30
  ageMonthsAtScreen  Float    @map("age_months_at_screen") // computed server-side, not client-trusted
  administeredAt     DateTime @map("administered_at")

  totalScore   Int?             @map("total_score")
  domainScores Json?            @map("domain_scores") // { communication: 45, grossMotor: 30, ... }
  outcome      ScreeningOutcome
  concernNote  String?          @map("concern_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient        Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  instrument     ScreeningInstrument @relation(fields: [instrumentId], references: [id])
  administeredBy User                @relation(fields: [administeredById], references: [id])
  appointment    Appointment?        @relation(fields: [appointmentId], references: [id])
  referral       ScreeningReferral?

  // One record per instrument per scheduled age — a re-screen uses a new
  // scheduledAgeMonths value (triggered screening) rather than overwriting this.
  @@unique([patientId, instrumentId, scheduledAgeMonths])
  @@index([patientId, administeredAt])
  @@index([outcome])
  @@map("screening_administrations")
}

// The loop-closing model. Schema ships now; referral creation/tracking
// endpoints are a follow-up phase — see the screening implementation plan.
model ScreeningReferral {
  id               String         @id @default(cuid())
  administrationId String         @unique @map("administration_id")
  referredTo       String         @map("referred_to") // Early Intervention, audiology, developmental peds
  referredAt       DateTime       @map("referred_at")
  status           ReferralStatus @default(PENDING)
  outcomeNote      String?        @map("outcome_note")
  closedAt         DateTime?      @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  administration ScreeningAdministration @relation(fields: [administrationId], references: [id], onDelete: Cascade)

  @@index([status, referredAt])
  @@map("screening_referrals")
}

// ─────────────────────────────────────────────────────────
//  DEVELOPMENTAL SURVEILLANCE — milestones observed every visit
// ─────────────────────────────────────────────────────────
//
// Distinct from screening above: screening is four discrete formal
// instruments, surveillance is the continuous record built from every
// well-child visit. Complementary, not a substitute for one another.

// Catalogue. Version-pinned, because the CDC/AAP thresholds moved in 2022
// (50th to 75th percentile) and will move again — never store bare
// milestone text without a source and version alongside it.
model MilestoneDefinition {
  id                 String          @id @default(cuid())
  code               String          @unique // "CDC2022_12M_LANG_WAVES"
  checklistAgeMonths Int             @map("checklist_age_months") // 2 4 6 9 12 15 18 24 30 36 48 60
  domain             MilestoneDomain
  description        String // as published — do not paraphrase
  source             String // "CDC Learn the Signs, Act Early"
  sourceVersion      String          @map("source_version") // "2022" — the 75th-percentile revision
  sortOrder          Int             @map("sort_order")
  isActive           Boolean         @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  observations MilestoneObservation[]

  @@index([checklistAgeMonths, domain])
  @@map("milestone_definitions")
}

// One row per milestone per visit. Both ages are stored: a preterm child is
// judged on corrected age, and the record must show which basis was used.
model MilestoneObservation {
  id            String  @id @default(cuid())
  patientId     String  @map("patient_id")
  definitionId  String  @map("definition_id")
  appointmentId String? @map("appointment_id")
  observedById  String  @map("observed_by_id")

  status MilestoneStatus
  source ObservationSource @default(CLINICIAN_OBSERVED)

  chronologicalAgeMonths Float    @map("chronological_age_months")
  correctedAgeMonths     Float?   @map("corrected_age_months") // null when not preterm, or past ~24 months
  ageBasisUsed           AgeBasis @map("age_basis_used")

  note       String?
  observedAt DateTime @default(now()) @map("observed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  definition  MilestoneDefinition @relation(fields: [definitionId], references: [id])
  appointment Appointment?        @relation(fields: [appointmentId], references: [id])
  observedBy  User                @relation(fields: [observedById], references: [id])

  // One record per milestone per visit — a re-check at a later visit is a
  // new observedAt, not an overwrite, so the trajectory stays intact.
  @@unique([patientId, definitionId, observedAt])
  @@index([patientId, observedAt])
  @@index([status])
  @@map("milestone_observations")
}

// Surveillance is not only milestones. Eliciting and documenting caregiver
// concern is a named component of it, and needs a home of its own.
model DevelopmentalConcern {
  id            String  @id @default(cuid())
  patientId     String  @map("patient_id")
  appointmentId String? @map("appointment_id")
  recordedById  String  @map("recorded_by_id")

  source      ConcernSource
  domain      MilestoneDomain?
  description String
  actionTaken String?          @map("action_taken") // screening triggered, referral, watchful waiting
  raisedAt    DateTime         @default(now()) @map("raised_at")
  resolvedAt  DateTime?        @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  recordedBy  User         @relation(fields: [recordedById], references: [id])

  @@index([patientId, raisedAt])
  @@map("developmental_concerns")
}

// ─────────────────────────────────────────────────────────
//  AUDIT LOG — HIPAA-style access trail
// ─────────────────────────────────────────────────────────

model AuditLog {
  id     String  @id @default(cuid())
  userId String? @map("user_id")

  action    String // CREATE, READ, UPDATE, DELETE, LOGIN
  entity    String // Patient, Appointment...
  entityId  String? @map("entity_id")
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
