# ═══════════════════════════════════════════════════════
#  PediTrack — environment configuration
# Copy to .env — defaults match docker-compose.yml, so no edits needed for local dev.
# ═══════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
# If your password contains @ : / ? # or spaces, URL-encode it (e.g. p@ss -> p%40ss).
#
# SEC-018 fix: sslmode=require is omitted from the local dev URL below because
# docker-compose runs Postgres on localhost without TLS.  For any non-local
# deployment (staging, production, managed Postgres such as Supabase / Neon / RDS)
# you MUST append &sslmode=require to encrypt the connection in transit:
#
#   DATABASE_URL="postgresql://user:pass@prod-host:5432/peditrack?schema=public&sslmode=require"
#
# For managed providers that supply a full connection string with SSL already
# configured (e.g. Neon's "postgres://...?sslmode=require"), use that string as-is.
DATABASE_URL="postgresql://peditrack:peditrack_dev@localhost:5433/peditrack?schema=public"

# ─── Auth ──────────────────────────────────────────────
# REQUIRED: Generate a strong secret before starting the server.
# The API will refuse to start if this value is absent, fewer than 32 chars,
# or still set to a known-weak placeholder.
#
# Generate one now:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# SEC-003: Never commit the real value. Add .env to .gitignore.
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# ─── API ───────────────────────────────────────────────
API_PORT=3001
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3000"
NODE_ENV="development"

# ─── Web ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_NAME="PediTrack"

# ─── Rate limiting (in-memory, no Redis required) ──────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# SEC-004: Auth endpoint throttle — 5 login attempts per 15 minutes.
AUTH_THROTTLE_TTL=900
AUTH_THROTTLE_LIMIT=5
